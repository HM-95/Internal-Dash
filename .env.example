# --- App URLs ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Internal session JWT (required in production) ---
JWT_SECRET=generate_a_long_random_string

# --- Internal users (local / one-time seeding only; never commit real passwords) ---
# JSON array: [{"username":"admin","password":"...","access_group":"code_access"}]
INTERNAL_USERS_SEED=

# Optional: protect POST /api/setup-users (header x-setup-secret)
SETUP_USERS_SECRET=

# --- AI (optional; features degrade gracefully if unset) ---
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Stripe (optional) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Email (optional) ---
RESEND_API_KEY=

# --- NextAuth (if used) ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# --- Dangerous / debug (production: leave unset) ---
# ENABLE_DEBUG_API=true
# ENABLE_DANGEROUS_MIGRATIONS=true
